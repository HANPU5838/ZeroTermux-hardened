<?xml version="1.0" encoding="utf-8"?>
<!-- Legacy (API <= 30) backup rules. Exclude everything sensitive: preferences hold AI API keys,
     session history and root/ADB state; files/ holds restore data. Only allow app-generated data. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
